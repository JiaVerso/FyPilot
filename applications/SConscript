import os
from building import *

cwd = GetCurrentDir()
# Select native RT-Thread workers explicitly; unfinished BF modules stay inactive.

# cmsis-dsp
cmsis_dsp_inc = os.path.join(cwd, '../../../packages/CMSIS-DSP/Include')

# , 'core/pid/pid_init.c', 'core/pid/pid.c'
src = ['main.c', 'fc/init.c', 'fc/flight_app.c', 'tasks/tasks.c', 'middleware/ipc/mp_ipc.c',
       'core/ekf/QuaternionEKF.c', 'core/pid/control_task.c']

if GetDepend('BSP_USING_CRSF'):
    src += ['elrs/crsf_parser.c', 'elrs/receiver_crsf.c']

if GetDepend('BSP_USING_BMI270'):
    src += ['sensors/imu_task.c', 'platform/mp_time.c', 'sensors/bmi270/bmi270.c',
        'sensors/bmi270/bmi2.c', 'sensors/attitude_task.c', 'core/pid/control_task.c']

if GetDepend('BSP_USING_BMI270') or not GetDepend('BSP_USING_HELLO_WORLD'):
    src += ['platform/mp_os.c', 'common/math/my_math.c', 'common/buffer/buffer.c']

    if not GetDepend('BSP_USING_BMI270'):
        src += ['platform/mp_time.c']

paths = [cwd] + [os.path.join(cwd, name) for name in
    ('core/ekf', 'core/pid', 'fc', 'elrs', 'sensors', 'sensors/bmi270', 'platform', 'common', 'common/math',
     'common/buffer', 'include', 'tasks', 'middleware/ipc')]

# Cortex-M7 使用 CMSIS-DSP 必须定义的架构与 FPU 宏
paths.append(os.path.join(cwd, '../sdk/cmsis-dsp/Include'))
CPPDEFINES = ['ARM_MATH_CM7', '__FPU_PRESENT=1U']

objs = DefineGroup('FyPilot flight modules', src, depend=[''], CPPPATH=paths, CPPDEFINES=CPPDEFINES,
                   LOCAL_CFLAGS=' -Wextra -Wno-cast-function-type')

Return('objs')

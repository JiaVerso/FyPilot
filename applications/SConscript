import os
from building import *

cwd = GetCurrentDir()
# Select native RT-Thread workers explicitly; unfinished BF modules stay inactive.
src = ['main.c', 'fc/init.c', 'fc/flight_app.c', 'tasks/tasks.c']

if GetDepend('BSP_USING_CRSF'):
    src += ['elrs/crsf_parser.c', 'elrs/receiver_crsf.c']
    
if GetDepend('BSP_USING_BMI270'):
    src += ['sensors/imu_task.c', 'platform/mp_time.c']

if not GetDepend('BSP_USING_HELLO_WORLD'):
    src += ['platform/mp_os.c', 'common/math/my_math.c', 'common/buffer/buffer.c']

    if not GetDepend('BSP_USING_BMI270'):
        src += ['platform/mp_time.c']

paths = [cwd] + [os.path.join(cwd, name) for name in
    ('fc', 'elrs', 'sensors', 'platform', 'common', 'common/math',
     'common/buffer', 'include', 'tasks')]

objs = DefineGroup('FyPilot flight modules', src, depend=[''], CPPPATH=paths,
                   LOCAL_CFLAGS=' -Wextra -Wno-cast-function-type')

Return('objs')

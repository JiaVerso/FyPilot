import os
import sys
import rtconfig
# Always use the bundled SDK; a stale RTT_ROOT environment cannot redirect it.
BSP_ROOT = Dir('#').abspath
RTT_ROOT = os.path.normpath(os.path.join(BSP_ROOT, '../../sdk/rt-thread'))
SDK_ROOT = os.path.normpath(os.path.join(BSP_ROOT, '../../sdk'))
sys.path.insert(0, os.path.join(RTT_ROOT, 'tools'))

from building import *
if not os.path.isfile('rtconfig.h'):
    from env_utility import defconfig
    defconfig(RTT_ROOT)
DefaultEnvironment(tools=[])

env = Environment(tools=['gcc', 'g++', 'gnulink', 'ar', 'gas'],
    AS=rtconfig.AS, ASFLAGS=rtconfig.AFLAGS, CC=rtconfig.CC, CFLAGS=rtconfig.CFLAGS,
    CXX=rtconfig.CXX, CXXFLAGS=rtconfig.CXXFLAGS, AR=rtconfig.AR, ARFLAGS='-rc',
    LINK=rtconfig.LINK, LINKFLAGS=rtconfig.LFLAGS)
env.PrependENVPath('PATH', rtconfig.EXEC_PATH)
env.Append(CPPDEFINES=['STM32H743xx', 'USE_HAL_DRIVER', 'USE_PWR_LDO_SUPPLY'])

Export('env', 'RTT_ROOT', 'SDK_ROOT', 'rtconfig')

objs = PrepareBuilding(env, RTT_ROOT, has_libcpu=False)
objs += SConscript(os.path.join(BSP_ROOT, '../../applications/SConscript'), variant_dir='build/applications', duplicate=0)
objs += SConscript(os.path.join(BSP_ROOT, '../../drivers/SConscript'), variant_dir='build/drivers', duplicate=0)
objs += SConscript(os.path.join(SDK_ROOT, 'stm32/SConscript'), variant_dir='build/sdk/stm32', duplicate=0)
objs += SConscript(os.path.join(BSP_ROOT, '../../tools/SConscript'),variant_dir='build/tools',duplicate=0,)

if not GetDepend('BSP_USING_HELLO_WORLD'):
    objs += SConscript(os.path.join(SDK_ROOT, 'cmsis-dsp/SConscript'), variant_dir='build/sdk/cmsis-dsp', duplicate=0)

DoBuilding('build/fypilot.elf', objs)

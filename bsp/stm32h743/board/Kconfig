menu "AOPAH743 hardware"
config BSP_USING_HELLO_WORLD
    bool "Power-on Hello World demo (USART3, 115200 8N1)"
    default y
config BSP_USING_GPIO
    bool
    default y
    select RT_USING_PIN
config BSP_USING_UART
    bool
    default y
    select RT_USING_SERIAL
config BSP_USING_UART3
    bool
    default y
config BSP_USING_UART6
    bool "Register USART6 PC6/PC7 for receiver"
    default y if !BSP_USING_HELLO_WORLD
config BSP_USING_CRSF
    bool "CRSF receiver on USART6 PC7, 420000 baud"
    default y
    select BSP_USING_UART6
config BSP_CRSF_RX_BUFFER_SIZE
    int "CRSF interrupt receive FIFO bytes"
    depends on BSP_USING_CRSF
    range 256 4096
    default 1024
config BSP_CRSF_SIGNAL_TIMEOUT_MS
    int "CRSF RC frame freshness timeout (ms)"
    depends on BSP_USING_CRSF
    range 20 1000
    default 100
config BSP_STM32_UART_V1_TX_TIMEOUT
    int
    default 20
config BSP_USING_SPI
    bool
    default y
    select RT_USING_SPI
config BSP_USING_SPI4
    bool
    depends on BSP_USING_SPI
    default y
config BSP_SPI4_TX_USING_POLL
    bool
    depends on BSP_USING_SPI4
    default y
config BSP_SPI4_RX_USING_POLL
    bool
    depends on BSP_USING_SPI4
    default y
config BSP_SCB_ENABLE_I_CACHE
    bool "Enable instruction cache"
    default y
config BSP_SCB_ENABLE_D_CACHE
    bool "Enable data cache (DMA is disabled in this target)"
    default n
config BSP_USING_BMI270
    bool "BMI270 on SPI4, CS PE11, INT1 PE15"
    depends on BSP_USING_SPI4
    default y
endmenu
